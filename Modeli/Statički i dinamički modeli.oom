<a:TemplateBody>{
	super(tableName);
	this.dbManip = DbManipulation.createConnection(DatabaseType.MsSQL_JDBC, &quot;78.28.157.8&quot;, &quot;1435&quot;, &quot;PIS2025&quot;,
			&quot;EtfPIS2025G6&quot;, &quot;EtfPIS2025G61543&quot;);
	this.conn = dbManip.getConnection();

	if (!tableName.isEmpty())
		this.getAllData();
}
