<a:Name>applicationWindow</a:Name>
<a:Code>applicationWindow</a:Code>
<a:CreationDate>1787492474</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:DataType>ApplicationWindow</a:DataType>
<c:ObjectDataType>
<o:Shortcut Ref="o1022"/>
</c:ObjectDataType>
