<a:Classifier.Header>/***********************************************************************
 * Module:  EditMenu.java
 * Author:  User
 * Purpose: Defines the Class EditMenu
 ***********************************************************************/</a:Classifier.Header>
<c:Operations>
<o:Operation Id="o929">
<a:ObjectID>C8B883F9-C51E-4B52-A6CE-8DDA962CEF8B</a:ObjectID>
<a:Name>EditMenu</a:Name>
<a:Code>EditMenu</a:Code>
<a:CreationDate>1787491668</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:TemplateBody>{
	super(&quot;Pretraga&quot;);
	
	Toolkit toolkit = Toolkit.getDefaultToolkit();

	
	nextMenuItem = new MenuItem(&quot;Sljedeće&quot;);
	Image nextIcon = toolkit.getImage(&quot;src/icons/new.png&quot;);
