<a:Code>showTable</a:Code>
<a:CreationDate>1787655724</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:Comment>Metoda koja prikazuje tabelu u zavisnosti od naziva koji je unesen kao parametar.
</a:Comment>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{

    if (customTable != null) {
        remove(customTable);
    }

    customTable = new CustomTable(applicationModel.getDataModel(), applicationModel);

    List&lt;List&lt;Object&gt;&gt; data = applicationModel.getDataModel().getData();
    boolean hasData = data.stream().anyMatch(col -&gt; col != null &amp;&amp; !col.isEmpty());

    if (hasData) {
        add(customTable, BorderLayout.CENTER);
        setVisible(true);
        customTable.setVisible(true);
    } else {
        setVisible(false);
        customTable.setVisible(false);
    }

    revalidate();
    repaint();
}
</a:TemplateBody>
