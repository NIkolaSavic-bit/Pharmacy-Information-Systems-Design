<o:Operation Id="o3307">
<a:ObjectID>25F3493D-5497-4EA1-945C-E1A2F7BCA1B7</a:ObjectID>
<a:Name>WindowFrame</a:Name>
<a:Code>WindowFrame</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:TemplateBody>{
		AppConfig config = AppConfig.getInstance();
		setTitle(config.getName());
		setSize(config.getWidth(), config.getHeight());
		setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
		setExtendedState(JFrame.MAXIMIZED_BOTH);
		setLocationRelativeTo(null);
		ImageIcon icon = new ImageIcon(&quot;src/icons/hermes-logo.png&quot;);
		setIconImage(icon.getImage());
		setVisible(true);

}
</a:TemplateBody>
</o:Operation>
</c:Operations>
