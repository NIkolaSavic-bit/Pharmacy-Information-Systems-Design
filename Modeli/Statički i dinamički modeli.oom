<a:Code>CreateCommand</a:Code>
<a:CreationDate>1787384080</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:TemplateBody>{
    super(applicationModel);
    this.entryData = entryData;
    this.newData = new HashMap&lt;String, String&gt;();
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o299">
<a:ObjectID>BE6D2310-B30F-4FAE-8D37-9AE7B2EC83EB</a:ObjectID>
