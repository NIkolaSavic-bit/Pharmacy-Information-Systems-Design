<o:Class Id="o2810">
<a:ObjectID>FCE70B9D-88C9-432F-B538-08C655B46112</a:ObjectID>
<a:Name>CustomTable</a:Name>
<a:Code>CustomTable</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:Comment>Custom table that displays data from GeneralTableModel. Supports clickable
cells and automatic ReadCommand execution if column has a refTable.
</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Classifier.Header> </a:Classifier.Header>
<a:Imports>import java.awt.BorderLayout;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.util.List;
import java.util.Vector;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import model.ApplicationModel;
import model.DataModel;
import model.EditingState;
import model.GeneralTableModel;
import model.TableColumnModel;
import model.command.Command;
import model.command.ReadCommand;
import model.command.RenderFormCommand;
</a:Imports>
<c:Attributes>
<o:Attribute Id="o2811">
<a:ObjectID>54CEB619-974C-4926-9804-9E865AB1402D</a:ObjectID>
<a:Name>table</a:Name>
<a:Code>table</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:DataType>JTable</a:DataType>
<a:Attribute.Visibility>-</a:Attribute.Visibility>
</o:Attribute>
<o:Attribute Id="o2812">
<a:ObjectID>BA085622-FA46-4009-B9A8-C08190F63ADF</a:ObjectID>
<a:Name>applicationModel</a:Name>
<a:Code>applicationModel</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:DataType>ApplicationModel</a:DataType>
<a:Attribute.Visibility>-</a:Attribute.Visibility>
</o:Attribute>
<o:Attribute Id="o2813">
<a:ObjectID>ADD386EB-90F8-4D6D-8393-3FB868D8A061</a:ObjectID>
<a:Name>tableModel</a:Name>
<a:Code>tableModel</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:DataType>GeneralTableModel</a:DataType>
<a:Attribute.Visibility>-</a:Attribute.Visibility>
</o:Attribute>
<o:Attribute Id="o2814">
<a:ObjectID>9B08EA70-CE31-4D53-92C0-B04482EF3A3C</a:ObjectID>
<a:Name>selectedRowIndex</a:Name>
<a:Code>selectedRowIndex</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:DataType>int</a:DataType>
<a:Attribute.Visibility>-</a:Attribute.Visibility>
<a:InitialValue>-1</a:InitialValue>
</o:Attribute>
</c:Attributes>
<c:Operations>
<o:Operation Id="o2815">
<a:ObjectID>F7E22EE4-0F71-4A57-9745-EC595155D4E6</a:ObjectID>
<a:Name>CustomTable</a:Name>
<a:Code>CustomTable</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:TemplateBody>{
	this.tableModel = tableModel;
	this.applicationModel = applicationModel;
	setLayout(new BorderLayout());

	// Column names
	String[] columnNames = tableModel.getColumns().stream().map(TableColumnModel::getColumLabel)
			.toArray(String[]::new);

	// Table model: only FK columns editable
	DefaultTableModel model = new DefaultTableModel(columnNames, 0) {
		@Override
		public boolean isCellEditable(int row, int column) {
			TableColumnModel colModel = tableModel.getColumns().get(column);
			return colModel.getRefTable() != null &amp;&amp; !colModel.getRefTable().isEmpty();
		}
	};

	// Add data
	for (List&lt;Object&gt; rowData : tableModel.getData()) {
		model.addRow(new Vector&lt;&gt;(rowData));
	}

	table = new JTable(model);
	table.setAutoResizeMode(JTable.AUTO_RESIZE_ALL_COLUMNS);
	table.getTableHeader().setReorderingAllowed(false);
	table.setRowHeight(30);

	JScrollPane scrollPane = new JScrollPane(table);
	add(scrollPane, BorderLayout.CENTER);

	// Mouse listener for clicks
	table.addMouseListener(new MouseAdapter() {
		@Override
		public void mouseClicked(MouseEvent e) {
			int row = table.rowAtPoint(e.getPoint());
			int col = table.columnAtPoint(e.getPoint());
			if (row &lt; 0 || col &lt; 0)
				return;

			TableColumnModel column = tableModel.getColumns().get(col);

			// Single click
			if (e.getClickCount() == 1) {
				selectedRowIndex = row;
				if (column.getRefTable() != null &amp;&amp; !column.getRefTable().isEmpty()) {
					showDropdown(row, col, column.getRefTable(), column.getRefColumn());
				}
				onRowClick(row,
						(Vector&lt;Object&gt;) ((DefaultTableModel) table.getModel()).getDataVector().elementAt(row));
			}

			// Double click
			if (e.getClickCount() == 2) {
				if (column.getRefTable() != null &amp;&amp; !column.getRefTable().isEmpty()) {
					openRefPanel(column.getRefTable());
				}
				onRowDoubleClick(row,
						(Vector&lt;Object&gt;) ((DefaultTableModel) table.getModel()).getDataVector().elementAt(row));
			}
		}
	});
}
</a:TemplateBody>
