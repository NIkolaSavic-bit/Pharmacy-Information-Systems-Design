<o:Parameter Id="o1074">
<a:ObjectID>D1C42E6C-5BC4-48BF-B6CF-1FACE9A96068</a:ObjectID>
<a:Name>rowData</a:Name>
<a:Code>rowData</a:Code>
<a:CreationDate>1787655563</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:WSDLDataType>java.util.List&lt;Object&gt;</a:WSDLDataType>
