<a:ObjectID>7C71F6F1-9BC3-4982-9ADD-A8F062FD6460</a:ObjectID>
<a:Name>idleState</a:Name>
<a:Code>idleState</a:Code>
<a:CreationDate>1787655678</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	nextButton.setEnabled(false);
	previousButton.setEnabled(false);
	firstButton.setEnabled(false);
	lastButton.setEnabled(false);
	newButton.setEnabled(false);
	editButton.setEnabled(false);
	deleteButton.setEnabled(false);
	acceptButton.setEnabled(false);
	cancelButton.setEnabled(false);
	reportButton.setEnabled(true);
}
</a:TemplateBody>
<a:WSDLDataType>void</a:WSDLDataType>
</o:Operation>
<o:Operation Id="o1103">
<a:ObjectID>C3FE0A8F-AB83-4E57-8882-0D2E63991427</a:ObjectID>
<a:Name>activeState</a:Name>
<a:Code>activeState</a:Code>
<a:CreationDate>1787655678</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	nextButton.setEnabled(true);
	previousButton.setEnabled(true);
	firstButton.setEnabled(true);
	lastButton.setEnabled(true);
	newButton.setEnabled(true);
	editButton.setEnabled(false);
	deleteButton.setEnabled(false);
	acceptButton.setEnabled(false);
	cancelButton.setEnabled(false);
	reportButton.setEnabled(true);
}
</a:TemplateBody>
<a:WSDLDataType>void</a:WSDLDataType>
</o:Operation>
<o:Operation Id="o1104">
<a:ObjectID>49788387-BB6C-4D55-8CAA-6D56769B944E</a:ObjectID>
<a:Name>editState</a:Name>
<a:Code>editState</a:Code>
<a:CreationDate>1787655678</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	nextButton.setEnabled(true);
	previousButton.setEnabled(true);
	firstButton.setEnabled(true);
	lastButton.setEnabled(true);
	newButton.setEnabled(true);
	editButton.setEnabled(true);
	deleteButton.setEnabled(true);
	acceptButton.setEnabled(true);
	cancelButton.setEnabled(true);
	reportButton.setEnabled(true);
}
</a:TemplateBody>
