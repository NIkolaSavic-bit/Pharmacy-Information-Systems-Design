<o:Operation Id="o2818">
<a:ObjectID>04F6AF85-6E68-4AE1-B3C1-09BA1CA6A0CB</a:ObjectID>
<a:Name>showDropdown</a:Name>
<a:Code>showDropdown</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
	DataModel tempModel = null;
	try {
		tempModel = new DataModel(refTable);
	} catch (Exception e) {
		e.printStackTrace();
		return;
	}

	// Load foreign key data
	List&lt;Object&gt; fkData = tempModel.loadFKData(refTable, refColumn);
	if (fkData == null || fkData.isEmpty())
		return;

	JComboBox&lt;Object&gt; comboBox = new JComboBox&lt;&gt;(fkData.toArray());
	table.getColumnModel().getColumn(col).setCellEditor(new DefaultCellEditor(comboBox));
	table.editCellAt(row, col);
}
</a:TemplateBody>
