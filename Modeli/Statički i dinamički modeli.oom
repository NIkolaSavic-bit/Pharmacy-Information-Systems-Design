<o:Operation Id="o1162">
<a:ObjectID>2F767CF5-8D14-4E24-8751-F8C5BA6B9D19</a:ObjectID>
<a:Name>openRefPanel</a:Name>
<a:Code>openRefPanel</a:Code>
<a:CreationDate>1787659741</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
	applicationModel.setDataModel(refTable);
	GeneralTableModel refTableModel = applicationModel.getDataModel();
	if (refTableModel == null)
		return;

	JFrame frame = new JFrame(&quot;Reference Table: &quot; + refTable);
	frame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
	frame.add(new CustomTable(refTableModel, applicationModel));
	frame.setSize(800, 600);
	frame.setLocationRelativeTo(null);
	frame.setVisible(true);
}
</a:TemplateBody>
<a:WSDLDataType>void</a:WSDLDataType>
<c:Parameters>
