<a:ObjectID>BF593108-1484-44CA-AF14-6F89E6D6A2F6</a:ObjectID>
<a:Name>entryData</a:Name>
<a:Code>entryData</a:Code>
<a:CreationDate>1787384080</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:WSDLDataType>Map&lt;String, JComponent&gt;</a:WSDLDataType>
