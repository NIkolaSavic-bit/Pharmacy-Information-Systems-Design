<a:ObjectID>4C3FEC69-B0BC-40C0-A308-B5A5170572BC</a:ObjectID>
<a:Name>dbName</a:Name>
<a:Code>dbName</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:WSDLDataType>xsd:string</a:WSDLDataType>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o3204">
<a:ObjectID>0E239A1D-466D-4297-8727-9A951A04CC6D</a:ObjectID>
<a:Name>user</a:Name>
<a:Code>user</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:WSDLDataType>xsd:string</a:WSDLDataType>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o3205">
<a:ObjectID>9CDEA281-55C9-4C99-BEEF-20AB3DDB551E</a:ObjectID>
<a:Name>password</a:Name>
<a:Code>password</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:WSDLDataType>xsd:string</a:WSDLDataType>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o3206">
<a:ObjectID>5193D651-18E8-4FF5-83AD-BB3AC0444260</a:ObjectID>
<a:Name>createConnection</a:Name>
<a:Code>createConnection</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:ReturnType>DbManipulation</a:ReturnType>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
	if(!(dbManip.size()&gt;0))
	{
		DbManipulation dbManipulation = new DbManipulation(type, address, port, dbName, user, password);
		dbManip.add(dbManipulation);
		
		return dbManipulation;
	}
	else
	{
		for (DbManipulation dbManipulation : dbManip) {
			if(dbManipulation.dataExists(type, address, port, dbName, user, password))
			{
				if(dbManipulation.isConnectionValid(5)) {
					return dbManipulation;
				}
				else {
					dbManipulation.closeConnection();
					
					DbManipulation manipulation = new DbManipulation(type, address, port, dbName, user, password);
					dbManip.add(manipulation);
					
					return manipulation;
				}
			}
			else {
				DbManipulation manipulation = new DbManipulation(type, address, port, dbName, user, password);
				dbManip.add(manipulation);
				
				return manipulation;
			}
		}
	}
	return null;
}
</a:TemplateBody>
<a:WSDLDataType>DbManipulation</a:WSDLDataType>
<c:Parameters>
