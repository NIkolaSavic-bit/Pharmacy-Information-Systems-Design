<a:Name>selectNextRow</a:Name>
<a:Code>selectNextRow</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:Comment> Selects the next row</a:Comment>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	int rowCount = table.getRowCount();
	if (rowCount == 0)
		return;
	int next = (selectedRowIndex &lt; rowCount - 1) ? selectedRowIndex + 1 : 0;
	setSelectedRowIndex(next);
}
</a:TemplateBody>
<a:WSDLDataType>void</a:WSDLDataType>
</o:Operation>
<o:Operation Id="o2829">
<a:ObjectID>1E4A908A-5458-4D7A-AA79-54007FD5B1BE</a:ObjectID>
<a:Name>selectPreviousRow</a:Name>
<a:Code>selectPreviousRow</a:Code>
<a:CreationDate>1787934538</a:CreationDate>
<a:Creator>Korisnik</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	int rowCount = table.getRowCount();
	if (rowCount == 0)
		return;
	int prev = (selectedRowIndex &gt; 0) ? selectedRowIndex - 1 : rowCount - 1;
	setSelectedRowIndex(prev);
}
</a:TemplateBody>
<a:WSDLDataType>void</a:WSDLDataType>
</o:Operation>
