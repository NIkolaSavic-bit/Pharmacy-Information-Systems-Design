<a:Modifier>Korisnik</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    SimpleDateFormat formatter = new SimpleDateFormat(&quot;dd/MM/yyyy HH:mm&quot;);
    rightLabel.setText(formatter.format(new Date()));
}
</a:TemplateBody>
<a:WSDLDataType>void</a:WSDLDataType>
</o:Operation>
