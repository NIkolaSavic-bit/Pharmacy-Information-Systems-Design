<a:Stereotype>Override</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	this.form.setVisible(true);
	Object rowId = null;
    this.rowIndex = table.getSelectedRow();
	List&lt;TableColumnModel&gt; tableColumns = this.applicationModel.getDataModel().getColumns();
	if(this.applicationModel.getDataModel().getData().size() &gt;0 &amp;&amp; rowIndex&gt;=0)
	{
    	List&lt;Object&gt; tableData = this.applicationModel.getDataModel().getData().get(rowIndex);
    	
    	for (int i=0; i&lt;tableColumns.size(); i++) {
			if(tableColumns.get(i).isPrimaryKey()){
				rowId = tableData.get(i);
			}
    	}
	}
    form.renderForm(this.applicationModel, state, rowIndex, rowId != null ? applicationModel.getDataModel().getRowById(rowId) : null);
}
</a:TemplateBody>
