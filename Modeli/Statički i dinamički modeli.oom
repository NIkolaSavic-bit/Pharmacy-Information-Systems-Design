<o:Operation Id="o283">
<a:ObjectID>3A5B22EA-C854-46C9-A574-FAC06543D024</a:ObjectID>
<a:Name>execute</a:Name>
<a:Code>execute</a:Code>
<a:CreationDate>1787383849</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787934539</a:ModificationDate>
<a:Modifier>Korisnik</a:Modifier>
<a:Stereotype>Override</a:Stereotype>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>  {
      int response = JOptionPane.showConfirmDialog(
              null,
              &quot;Da li ste sigurni da želite da obrišete ovaj podatak?&quot;,
              &quot;Potvrda brisanja&quot;,
              JOptionPane.YES_NO_OPTION,
              JOptionPane.WARNING_MESSAGE
          );

          if (response == JOptionPane.YES_OPTION) {
              System.out.println(&quot;Podatak je obrisan.&quot;);
  	Object rowId = null;
      this.rowIndex = table.getSelectedRow();
  	List&lt;TableColumnModel&gt; tableColumns = this.applicationModel.getDataModel().getColumns();
  	List&lt;Object&gt; tableData = this.applicationModel.getDataModel().getData().get(rowIndex);
  	
  	for (int i=0; i&lt;tableColumns.size(); i++) {
	if(tableColumns.get(i).isPrimaryKey()){
		rowId = tableData.get(i);
	}
}
  	
  	this.applicationModel.getDataModel().deleteRowById(rowId);
  	this.applicationModel.getDataModel().getAllData();
  	applicationModel.notifySubscribers();
          }
      JOptionPane.showMessageDialog(null, &quot;Podatak je uspješno obrisan!&quot;);
  }
</a:TemplateBody>
<a:WSDLDataType>void</a:WSDLDataType>
