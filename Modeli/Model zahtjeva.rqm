{\colortbl ;\red0\green0\blue0;}
\viewkind4\uc1\pard\cf1\f0\fs20 Administrator mo\&#39;9ee pregledati sve evidentirane korisni\f1\&#39;e8ke naloge, njihove osnovne podatke, status aktivnosti i dodijeljene role.\cf0\f2\fs17\par
