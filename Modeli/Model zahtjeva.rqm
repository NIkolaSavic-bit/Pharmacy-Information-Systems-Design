{\colortbl ;\red0\green0\blue0;}
\viewkind4\uc1\pard\cf1\f0\fs20 Sistem omogu\f1\&#39;e6ava administratoru upravljanje korisni\&#39;e8kim nalozima zaposlenih u apoteci, u skladu sa dodijeljenim rolama i pravima pristupa.\cf0\f2\fs17\par
}
</a:Description>
