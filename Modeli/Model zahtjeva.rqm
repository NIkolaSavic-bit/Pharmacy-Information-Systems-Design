<c:Requirements>
<o:Requirement Id="o59">
<a:ObjectID>5D65E2A6-4A4C-47D1-9226-CFB655BBD46F</a:ObjectID>
<a:Requirement.Title>Upotrebljivost</a:Requirement.Title>
<a:Code>REQ_0017</a:Code>
<a:CreationDate>1779305778</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1779305808</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Testable/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238{\*\fname Times New Roman;}Times New Roman CE;}{\f2\fnil\fcharset0 Microsoft Sans Serif;}}
{\colortbl ;\red0\green0\blue0;}
\viewkind4\uc1\pard\cf1\f0\fs20 Korisni\f1\&#39;e8ki interfejs treba da bude razumljiv i dosljedan, tako da korisnik sa osnovnim znanjem rada na ra\&#39;e8unaru mo\&#39;9ee obavljati uobi\&#39;e8ajene zadatke bez posebne obuke.\cf0\f2\fs17\par
}
</a:Description>
</o:Requirement>
<o:Requirement Id="o60">
<a:ObjectID>F6C339B2-83BB-4527-841A-FD18F0FE358B</a:ObjectID>
<a:Requirement.Title>Bezbjednost</a:Requirement.Title>
<a:Code>REQ_0018</a:Code>
<a:CreationDate>1779305808</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1779305826</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Testable/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238{\*\fname Times New Roman;}Times New Roman CE;}{\f2\fnil\fcharset0 Microsoft Sans Serif;}}
{\colortbl ;\red0\green0\blue0;}
\viewkind4\uc1\pard\cf1\f0\fs20 Sistem mora za\&#39;9atititi poslovne i li\f1\&#39;e8ne podatke kontrolom pristupa putem korisni\&#39;e8kih naloga, rola i prava. Rad sistema ne smije mijenjati datoteke i podatke koji mu ne pripadaju.\cf0\f2\fs17\par
}
</a:Description>
</o:Requirement>
<o:Requirement Id="o61">
<a:ObjectID>3C07095F-2D32-4968-B43C-338BBE8E5FB4</a:ObjectID>
<a:Requirement.Title>Korisnička pomoć</a:Requirement.Title>
<a:Code>REQ_0019</a:Code>
<a:CreationDate>1779305826</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1779305847</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Testable/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238{\*\fname Times New Roman;}Times New Roman CE;}{\f2\fnil\fcharset0 Microsoft Sans Serif;}}
{\colortbl ;\red0\green0\blue0;}
\viewkind4\uc1\pard\cf1\f0\fs20 Sistem treba da sadr\&#39;9ei lako dostupnu korisni\f1\&#39;e8ku pomo\&#39;e6 sa opisom namjene funkcija, potrebnih podataka i postupaka za izvr\&#39;9aavanje osnovnih zadataka.\cf0\f2\fs17\par
}
</a:Description>
</o:Requirement>
<o:Requirement Id="o62">
<a:ObjectID>1778962E-E560-4B74-A9A1-6448C9AFF56F</a:ObjectID>
<a:Requirement.Title>Lokalizacija</a:Requirement.Title>
<a:Code>REQ_0020</a:Code>
<a:CreationDate>1779305847</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1779305861</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Testable/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238{\*\fname Times New Roman;}Times New Roman CE;}{\f2\fnil\fcharset0 Microsoft Sans Serif;}}
{\colortbl ;\red0\green0\blue0;}
\viewkind4\uc1\pard\cf1\f0\fs20 Korisni\f1\&#39;e8ki interfejs treba da podr\&#39;9eava srpski jezik na latinici i \&#39;e6irilici te engleski jezik, uz mogu\&#39;e6nost izbora jezika u postavkama aplikacije.\cf0\f2\fs17\par
}
</a:Description>
</o:Requirement>
<o:Requirement Id="o63">
<a:ObjectID>4BAD7AB6-5B45-40AE-B069-FFE447334502</a:ObjectID>
<a:Requirement.Title>Modularnost</a:Requirement.Title>
<a:Code>REQ_0021</a:Code>
<a:CreationDate>1779305861</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1779305892</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Testable/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Times New Roman;}{\f1\fnil\fcharset238{\*\fname Times New Roman;}Times New Roman CE;}{\f2\fnil\fcharset0 Microsoft Sans Serif;}}
{\colortbl ;\red0\green0\blue0;}
\viewkind4\uc1\pard\cf1\f0\fs20 Sistem treba organizovati u jasno odvojene module kako bi se nove funkcionalnosti mogle dodavati uz minimalan uticaj na postoje\f1\&#39;e6e dijelove te kako bi odr\&#39;9eavanje, testiranje i otklanjanje gre\&#39;9aaka bili jednostavniji.\cf0\f2\fs17\par
}
</a:Description>
</o:Requirement>
<o:Requirement Id="o64">
<a:ObjectID>E38DA489-2D2D-49F1-84A6-68976510D0A7</a:ObjectID>
<a:Requirement.Title>Java programski jezik</a:Requirement.Title>
