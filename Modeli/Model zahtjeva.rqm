{\colortbl ;\red0\green0\blue0;}
\viewkind4\uc1\pard\cf1\f0\fs20 Administrator mo\&#39;9ee kreirati korisni\f1\&#39;e8ki nalog za zaposlenog, izmijeniti podatke naloga, aktivirati ili deaktivirati nalog te dodijeliti odgovaraju\&#39;e6e role i prava pristupa.\cf0\f2\fs17\par
