<a:Name>getScrollableTracksViewportWidth</a:Name>
<a:Code>getScrollableTracksViewportWidth</a:Code>
<a:CreationDate>1787659577</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787659591</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>boolean</a:ReturnType>
<a:TemplateBody>{
	if (getPreferredSize().width &lt; getParent().getWidth()) {
        return true;  // stretch only if smaller than viewport
    } else {
        return false; // allow scrolling if content wider
    }
}
</a:TemplateBody>
