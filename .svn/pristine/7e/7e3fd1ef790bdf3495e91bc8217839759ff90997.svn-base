import javax.swing.JPanel;
import javax.swing.JPasswordField;
import javax.swing.JTextField;
import javax.swing.SwingConstants;
import model.ApplicationModel;
import view.config.AppConfig;
</a:Imports>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,154={BCE16AEA-6699-4EBE-A32C-82226C6E17D0},Javadoc@author,21=@author Aleksej Mutić
{F33BF047-BD1C-44CD-A853-1089AA1FE408},Javadoc@version,14=@version 1.0


</a:ExtendedAttributesText>
<c:Attributes>
<o:Attribute Id="o1995">
<a:ObjectID>242B492F-B893-4286-953E-C857728B336C</a:ObjectID>
