<o:Operation Id="o1977">
<a:ObjectID>18B46C8F-CE4E-48D1-820D-C7BEB522203D</a:ObjectID>
<a:Name>setSelectedRowIndex</a:Name>
<a:Code>setSelectedRowIndex</a:Code>
<a:CreationDate>1787655724</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787655741</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Comment> Sets the selected row and scrolls it into view</a:Comment>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	this.selectedRowIndex = selectedRowIndex;
	if (selectedRowIndex &gt;= 0 &amp;&amp; selectedRowIndex &lt; table.getRowCount()) {
		table.setRowSelectionInterval(selectedRowIndex, selectedRowIndex);
		table.scrollRectToVisible(table.getCellRect(selectedRowIndex, 0, true));
	}
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1978">
<a:ObjectID>1D971E3D-3B76-4BB4-8ED9-893622636C40</a:ObjectID>
<a:Name>selectedRowIndex</a:Name>
<a:Code>selectedRowIndex</a:Code>
<a:CreationDate>1787655724</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787655741</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:Parameter.DataType>int</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o1979">
<a:ObjectID>6FCCED8E-5507-4591-9F8D-294D318D36AA</a:ObjectID>
<a:Name>selectNextRow</a:Name>
<a:Code>selectNextRow</a:Code>
<a:CreationDate>1787655724</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787655741</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Comment> Selects the next row</a:Comment>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	int rowCount = table.getRowCount();
	if (rowCount == 0)
		return;
	int next = (selectedRowIndex &lt; rowCount - 1) ? selectedRowIndex + 1 : 0;
	setSelectedRowIndex(next);
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o1980">
<a:ObjectID>6BCD3188-FAFE-4035-BA41-201BB92D8808</a:ObjectID>
<a:Name>selectPreviousRow</a:Name>
<a:Code>selectPreviousRow</a:Code>
<a:CreationDate>1787655724</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787655741</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	int rowCount = table.getRowCount();
	if (rowCount == 0)
		return;
	int prev = (selectedRowIndex &gt; 0) ? selectedRowIndex - 1 : rowCount - 1;
	setSelectedRowIndex(prev);
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o1981">
<a:ObjectID>A3661EBC-42EE-41A7-A595-80E628C80871</a:ObjectID>
<a:Name>selectFirstRow</a:Name>
<a:Code>selectFirstRow</a:Code>
<a:CreationDate>1787655724</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787655741</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	if (table.getRowCount() &gt; 0)
		setSelectedRowIndex(0);
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o1982">
<a:ObjectID>1E96A141-CFF7-45F9-AD36-31ED867F3A35</a:ObjectID>
<a:Name>selectLastRow</a:Name>
<a:Code>selectLastRow</a:Code>
<a:CreationDate>1787655724</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787655741</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	int lastIndex = table.getRowCount() - 1;
	if (lastIndex &gt;= 0)
		setSelectedRowIndex(lastIndex);
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o1983">
