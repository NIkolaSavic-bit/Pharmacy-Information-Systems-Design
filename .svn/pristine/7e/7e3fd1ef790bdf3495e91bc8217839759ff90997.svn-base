<o:Class Id="o188">
<a:ObjectID>E9578E82-24CD-42CB-BB00-34A2427509E8</a:ObjectID>
<a:Name>MsSqlJdbcConnection</a:Name>
<a:Code>MsSqlJdbcConnection</a:Code>
<a:CreationDate>1787384903</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787385090</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:UseParentNamespace>0</a:UseParentNamespace>
