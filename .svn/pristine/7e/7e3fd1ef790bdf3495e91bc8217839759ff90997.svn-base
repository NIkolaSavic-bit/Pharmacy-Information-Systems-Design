<a:Creator>User</a:Creator>
<a:ModificationDate>1787659760</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Comment> ----------------------------
 Selection &amp; Navigation Methods
 ----------------------------
 Returns the index of the currently selected row</a:Comment>
<a:GlobalObjectID/>
<a:ReturnType>int</a:ReturnType>
<a:TemplateBody>{
	return selectedRowIndex;
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o1080">
<a:ObjectID>D908C6DF-4B30-4292-9B84-05C77D0BBEBF</a:ObjectID>
<a:Name>setSelectedRowIndex</a:Name>
<a:Code>setSelectedRowIndex</a:Code>
<a:CreationDate>1787659741</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787659760</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Comment> Sets the selected row and scrolls it into view</a:Comment>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	this.selectedRowIndex = selectedRowIndex;
	if (selectedRowIndex &gt;= 0 &amp;&amp; selectedRowIndex &lt; table.getRowCount()) {
		table.setRowSelectionInterval(selectedRowIndex, selectedRowIndex);
		table.scrollRectToVisible(table.getCellRect(selectedRowIndex, 0, true));
	}
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1081">
<a:ObjectID>6498924E-25E9-4755-A8BD-0584D6B94719</a:ObjectID>
<a:Name>selectedRowIndex</a:Name>
<a:Code>selectedRowIndex</a:Code>
