<o:Operation Id="o647">
<a:ObjectID>2218A977-56BA-493F-A8A6-81AE9B60A669</a:ObjectID>
<a:Name>_STATIC_INITIALIZER</a:Name>
<a:Code>_STATIC_INITIALIZER</a:Code>
<a:CreationDate>1787660744</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787660761</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>staticInitializer</a:Stereotype>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>	{
		roleTableAccess.put(&quot;AS&quot;, Arrays.asList(&quot;Drzava&quot;, &quot;Region&quot;, 
				&quot;Vozilo&quot;, &quot;Adresnica&quot;, &quot;Posiljka&quot;, &quot;Korisnički nalog&quot;));
		roleTableAccess.put(&quot;Magacioner&quot;, Arrays.asList(&quot;Region&quot;));
		roleTableAccess.put(&quot;Menadžer poslovnice&quot;, Arrays.asList(&quot;Drzava&quot;, &quot;Region&quot;));
		roleTableAccess.put(&quot;Vozac&quot;, Arrays.asList(&quot;Drzava&quot;, &quot;Region&quot;));
		roleTableAccess.put(&quot;Referent za logistiku&quot;, Arrays.asList(&quot;Drzava&quot;, &quot;Region&quot;));
		roleTableAccess.put(&quot;Registrovani korisnik&quot;, Arrays.asList(&quot;Drzava&quot;, &quot;Region&quot;));
		roleTableAccess.put(&quot;Neregistrovani korisnik&quot;, Arrays.asList(&quot;Drzava&quot;, &quot;Region&quot;));
		roleTableAccess.put(&quot;Prijavljeni korisnik&quot;, Arrays.asList(&quot;Drzava&quot;, &quot;Region&quot;));
	}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o648">
<a:ObjectID>5D26BEEF-DB68-49EB-8EB1-43FD4C31C792</a:ObjectID>
<a:Name>main</a:Name>
<a:Code>main</a:Code>
<a:CreationDate>1787660744</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787660761</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
     SwingUtilities.invokeLater(() -&gt; {
         String path = &quot;src/resources/databaseXML.xml&quot;; // Putanja do XML fajla
         XMLTreeModel model = new XMLTreeModel(null, path, &quot;admin&quot;);

         JTree tree = new JTree(model);
         JScrollPane scrollPane = new JScrollPane(tree);

         JFrame frame = new JFrame(&quot;XMLTreeModel Test&quot;);
         frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
         frame.setSize(400, 300);
         frame.add(scrollPane);
         frame.setVisible(true);
     });
 }
</a:TemplateBody>
