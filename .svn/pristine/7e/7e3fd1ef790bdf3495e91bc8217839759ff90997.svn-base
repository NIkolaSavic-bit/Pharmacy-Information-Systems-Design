<c:Operations>
<o:Operation Id="o1966">
<a:ObjectID>3F3ECD03-B454-4E45-9876-DC8F986F731A</a:ObjectID>
<a:Name>CustomTable</a:Name>
<a:Code>CustomTable</a:Code>
<a:CreationDate>1787655724</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787655741</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:GlobalObjectID/>
<a:TemplateBody>{
	this.tableModel = tableModel;
	this.applicationModel = applicationModel;
	setLayout(new BorderLayout());

	// Column names
	String[] columnNames = tableModel.getColumns().stream().map(TableColumnModel::getColumLabel)
			.toArray(String[]::new);

	// Table model: only FK columns editable
	DefaultTableModel model = new DefaultTableModel(columnNames, 0) {
		@Override
		public boolean isCellEditable(int row, int column) {
			TableColumnModel colModel = tableModel.getColumns().get(column);
			return colModel.getRefTable() != null &amp;&amp; !colModel.getRefTable().isEmpty();
		}
	};

	// Add data
	for (List&lt;Object&gt; rowData : tableModel.getData()) {
		model.addRow(new Vector&lt;&gt;(rowData));
	}

	table = new JTable(model);
	table.setAutoResizeMode(JTable.AUTO_RESIZE_ALL_COLUMNS);
	table.getTableHeader().setReorderingAllowed(false);
	table.setRowHeight(30);

	JScrollPane scrollPane = new JScrollPane(table);
	add(scrollPane, BorderLayout.CENTER);

	// Mouse listener for clicks
	table.addMouseListener(new MouseAdapter() {
		@Override
		public void mouseClicked(MouseEvent e) {
			int row = table.rowAtPoint(e.getPoint());
			int col = table.columnAtPoint(e.getPoint());
			if (row &lt; 0 || col &lt; 0)
				return;

			TableColumnModel column = tableModel.getColumns().get(col);

			// Single click
			if (e.getClickCount() == 1) {
				selectedRowIndex = row;
				if (column.getRefTable() != null &amp;&amp; !column.getRefTable().isEmpty()) {
					showDropdown(row, col, column.getRefTable(), column.getRefColumn());
				}
				onRowClick(row,
						(Vector&lt;Object&gt;) ((DefaultTableModel) table.getModel()).getDataVector().elementAt(row));
			}

			// Double click
			if (e.getClickCount() == 2) {
				if (column.getRefTable() != null &amp;&amp; !column.getRefTable().isEmpty()) {
					openRefPanel(column.getRefTable());
				}
				onRowDoubleClick(row,
						(Vector&lt;Object&gt;) ((DefaultTableModel) table.getModel()).getDataVector().elementAt(row));
			}
		}
	});
}
</a:TemplateBody>
<c:Parameters>
