<o:Operation Id="o258">
<a:ObjectID>E1A7E349-C720-4F96-A234-2ABA26129766</a:ObjectID>
<a:Name>DbManipulation</a:Name>
<a:Code>DbManipulation</a:Code>
<a:CreationDate>1787385364</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787385392</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:GlobalObjectID/>
<a:TemplateBody>{
	
	switch (type) {
	case MsSQL_JDBC:
		dbConnection = new MsSqlJdbcConnection();
		break;
	case MsSQL_JTDS:
		dbConnection = new MsSqlJtdsConnection();
		break;
	case MySQL:
		dbConnection = new MySqlConnection();
		break;
	default:
		break;
	}
	
	dbConnection.getConnection(address, port, dbName, user, password);
}
</a:TemplateBody>
