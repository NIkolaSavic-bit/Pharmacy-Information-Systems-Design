package database;

/**
 * Predstavlja tip i vrijednost parametra baze podataka.
 */
public class DatabaseParameter {

    private final String type;
    private final Object value;

    /**
     * Inicijalizuje objekat za rad u aplikaciji.
     *
     * @param type naziv tipa baze ili SQL tipa podatka
     * @param value tekstualna vrijednost koja se upisuje
     */
    public DatabaseParameter(String type, Object value) {
        this.type = type;
        this.value = value;
    }

    /**
     * Vraća tip podatka ili baze.
     *
     * @return tip podatka ili baze
     */
    public String getType() {
        return type;
    }

    /**
     * Vraća vrijednost parametra.
     *
     * @return vrijednost parametra
     */
    public Object getValue() {
        return value;
    }
}
