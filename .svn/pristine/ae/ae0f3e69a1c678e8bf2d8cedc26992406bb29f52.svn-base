<a:Name>loadFKData</a:Name>
<a:Code>loadFKData</a:Code>
<a:CreationDate>1787327300</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787327319</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>List&lt;Object&gt;</a:ReturnType>
<a:TemplateBody>{
	List&lt;Object&gt; fkData = new Vector&lt;Object&gt;();
	try {
		callableSatement = conn.prepareCall(&quot;{ call udsp_GetFKData(?,?) }&quot;);

		callableSatement.setString(1, refTable);
		callableSatement.setString(2, refColumn);
		resultSet = callableSatement.executeQuery();

		while (resultSet.next()) {
			fkData.add(resultSet.getObject(refColumn));
		}
		return fkData;
	} catch (SQLException e) {
		// TODO Auto-generated catch block
		e.printStackTrace();
	}
	return null;
}
</a:TemplateBody>
