<a:ModificationDate>1787326812</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:GlobalObjectID/>
<a:TemplateBody>{
	setContext(new ApplicationContext());
	setApplicationState(new IdleState());
	dataModel = context.getTableStack().getLast();
	this.subscribers = new Vector&lt;Subscriber&gt;();
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o281">
<a:ObjectID>15D38C34-7AAD-4658-97DF-A5C9E1D43265</a:ObjectID>
