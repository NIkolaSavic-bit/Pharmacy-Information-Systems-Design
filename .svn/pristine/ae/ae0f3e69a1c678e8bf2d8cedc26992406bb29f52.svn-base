<a:Name>toString</a:Name>
<a:Code>toString</a:Code>
<a:CreationDate>1787327300</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787327319</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>String</a:ReturnType>
<a:TemplateBody>{
	String returnString = &quot;&quot;;
	for (int i = 0; i &lt; columns.size(); i++) {
		TableColumnModel column = columns.get(i);

		returnString += column.getColumName() + &quot;: [&quot;;

		for (List&lt;Object&gt; tableObject : data) {
			returnString += tableObject.get(i).toString() + &quot;, &quot;;
		}
		returnString += &quot;]\n&quot;;
	}
	return returnString;
}
</a:TemplateBody>
