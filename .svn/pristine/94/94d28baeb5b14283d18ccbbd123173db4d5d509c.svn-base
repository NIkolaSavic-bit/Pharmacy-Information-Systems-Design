</o:Operation>
<o:Operation Id="o849">
<a:ObjectID>2DDB6ED2-20FD-49E5-9F10-08CB727BB938</a:ObjectID>
<a:Name>createConnection</a:Name>
<a:Code>createConnection</a:Code>
<a:CreationDate>1787333484</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>DbManipulation</a:ReturnType>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
	if(!(dbManip.size()&gt;0))
	{
		DbManipulation dbManipulation = new DbManipulation(type, address, port, dbName, user, password);
		dbManip.add(dbManipulation);
		
		return dbManipulation;
	}
	else
	{
		for (DbManipulation dbManipulation : dbManip) {
			if(dbManipulation.dataExists(type, address, port, dbName, user, password))
			{
				if(dbManipulation.isConnectionValid(5)) {
					return dbManipulation;
				}
				else {
					dbManipulation.closeConnection();
					
					DbManipulation manipulation = new DbManipulation(type, address, port, dbName, user, password);
					dbManip.add(manipulation);
					
					return manipulation;
				}
			}
			else {
				DbManipulation manipulation = new DbManipulation(type, address, port, dbName, user, password);
				dbManip.add(manipulation);
				
				return manipulation;
			}
		}
	}
	return null;
}
</a:TemplateBody>
