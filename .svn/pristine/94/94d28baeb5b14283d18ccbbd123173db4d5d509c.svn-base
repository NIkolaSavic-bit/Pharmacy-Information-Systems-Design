<o:Operation Id="o428">
<a:ObjectID>A9B2BFD1-5D34-4A20-93D0-9914043DB6EE</a:ObjectID>
<a:Name>isConnectionValid</a:Name>
<a:Code>isConnectionValid</a:Code>
<a:CreationDate>1787333484</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
	int index = dbManip.indexOf(this);
	
	if(dbManip.size() &gt; 0 &amp;&amp; index != -1)
	{
		dbConnection = dbManip.get(index).dbConnection;
	}
	else {
		return false;
	}
	
	if(dbConnection != null)
	{
		return dbConnection.isConnectionValid(timeout);
		
	}
	return false;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o429">
<a:ObjectID>5B6A9377-0625-4E64-A046-89620A212429</a:ObjectID>
<a:Name>timeout</a:Name>
<a:Code>timeout</a:Code>
<a:CreationDate>1787333484</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:Parameter.DataType>int</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o430">
<a:ObjectID>501BF5B2-7224-453E-9743-912FA1EDC10F</a:ObjectID>
<a:Name>closeConnection</a:Name>
<a:Code>closeConnection</a:Code>
<a:CreationDate>1787333484</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	int index = dbManip.indexOf(this);
	if(dbManip.size() &gt; 0 &amp;&amp; index != -1)
	{
		dbConnection = dbManip.get(index).dbConnection;
	}
	if(dbConnection != null)
	{
		dbConnection.closeConnection();
		
		if(index != -1)
		{
			dbManip.remove(index);
		}
	}
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o431">
<a:ObjectID>CB384068-4F0B-4E4A-94D0-E7A81E3DBD35</a:ObjectID>
<a:Name>getDbName</a:Name>
<a:Code>getDbName</a:Code>
<a:CreationDate>1787333484</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>String</a:ReturnType>
<a:TemplateBody>{
	return dbConnection.getDbName();
}
</a:TemplateBody>
</o:Operation>
