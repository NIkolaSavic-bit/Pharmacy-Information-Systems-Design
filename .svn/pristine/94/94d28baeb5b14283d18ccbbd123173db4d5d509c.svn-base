<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>Connection</a:ReturnType>
<a:TemplateBody>{
	int index = dbManip.indexOf(this);
	if(dbManip.size() &gt; 0 &amp;&amp; index != -1)
	{
		dbConnection = dbManip.get(index).dbConnection;
	}
	if(dbConnection != null)
	{
		return dbConnection.getConnection();
	}
	return null;
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o421">
<a:ObjectID>506EEBAA-0D49-45A3-9BAE-A2565C9BC76F</a:ObjectID>
<a:Name>dataExists</a:Name>
<a:Code>dataExists</a:Code>
<a:CreationDate>1787333484</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
	if(dbConnection.getType().equals(type) 
			&amp;&amp; dbConnection.getAddress() == address
			&amp;&amp; dbConnection.getPort() == port
			&amp;&amp; dbConnection.getUser() == user
			&amp;&amp; dbConnection.getPassword() == password)
	{
		return true;
	}
	return false;
}
</a:TemplateBody>
