<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o847">
<a:ObjectID>4D5F0A63-402A-4C2E-915E-C54AFC19BEDB</a:ObjectID>
<a:Name>user</a:Name>
<a:Code>user</a:Code>
<a:CreationDate>1787333484</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o848">
<a:ObjectID>B717C3D1-CE05-4834-A487-3E9B81513902</a:ObjectID>
<a:Name>password</a:Name>
<a:Code>password</a:Code>
<a:CreationDate>1787333484</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787333506</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
