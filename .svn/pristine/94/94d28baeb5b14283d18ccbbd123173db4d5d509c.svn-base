<o:Operation Id="o253">
<a:ObjectID>811ADA64-A883-4E91-8894-870EBCBB4DCB</a:ObjectID>
<a:Name>getHighestPrimaryKey</a:Name>
<a:Code>getHighestPrimaryKey</a:Code>
<a:CreationDate>1787332736</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787332767</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>Integer</a:ReturnType>
<a:TemplateBody>{
    if (columns == null || data == null || data.isEmpty())
        return null;

    int pkIndex = -1;
    for (int i = 0; i &lt; columns.size(); i++) {
        if (columns.get(i).isPrimaryKey()) {
            pkIndex = i;
            break;
        }
    }

    if (pkIndex == -1) {
        return null;
    }

    Integer max = null;
    for (List&lt;Object&gt; row : data) {
        Object value = row.get(pkIndex);
        if (value instanceof Number) {
            int intValue = ((Number) value).intValue();
            if (max == null || intValue &gt; max) {
                max = intValue;
            }
        }
    }

    return max;
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o254">
<a:ObjectID>4CB353DB-C4D9-4B81-9F67-9A20BC7267BA</a:ObjectID>
<a:Name>ensureDummyRow</a:Name>
<a:Code>ensureDummyRow</a:Code>
<a:CreationDate>1787332736</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787332767</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Comment> Dodaje praznu row ako nema podataka</a:Comment>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    if (data.isEmpty() &amp;&amp; columns != null &amp;&amp; !columns.isEmpty()) {
        List&lt;Object&gt; emptyRow = new Vector&lt;&gt;();
        for (int i = 0; i &lt; columns.size(); i++) {
            emptyRow.add(null);
        }
        data.add(emptyRow);
    }
}
</a:TemplateBody>
</o:Operation>
