        callableSatement = conn.prepareCall(&quot;{ call &quot; + crudOps.get(&quot;insert&quot;) + &quot; }&quot;);

        // Pretpostavka: imena parametara se slažu s imenima kolona
        callableSatement.setString(1, params.get(&quot;Username&quot;));
        callableSatement.setString(2, params.get(&quot;Password&quot;));
        callableSatement.setString(3, params.get(&quot;Ime&quot;));
        callableSatement.setString(4, params.get(&quot;Prezime&quot;));
        callableSatement.setString(5, params.get(&quot;Oznaka Role&quot;));

        callableSatement.execute();
    } catch (SQLException e) {
        e.printStackTrace();
        JOptionPane.showMessageDialog(null, &quot;Greška prilikom dodavanja korisnika!&quot;, &quot;Greška&quot;, JOptionPane.ERROR_MESSAGE);
