<o:Operation Id="o759">
<a:ObjectID>215C9F59-42A3-4912-B41A-96927C16FA52</a:ObjectID>
<a:Name>editRow</a:Name>
<a:Code>editRow</a:Code>
<a:CreationDate>1787328297</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787328427</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>Override</a:Stereotype>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	try {
		callableSatement = conn.prepareCall(&quot;{ call &quot; + crudOps.get(&quot;update&quot;) + &quot; }&quot;);

		DataTypeMapper mapper = new DataTypeMapper();
		int index = 1;

		for (TableColumnModel column : columns) {
			String colName = column.getColumName();
			String type = column.getColumType();
			String value = params.get(colName);

			if (value == null) {
				callableSatement.setObject(index, null);
			} else {
				mapper.mapDataToType(type, value, callableSatement, index);
			}
			index++;
		}

		System.out.println(&quot;Callable (editRow): &quot; + callableSatement.toString());

		callableSatement.executeUpdate();
		this.getAllData();

	} catch (SQLException e) {
		e.printStackTrace();
	}
}
</a:TemplateBody>
