<o:Operation Id="o336">
<a:ObjectID>1BF7D2A7-AA37-4B6B-BB75-39847A3974CF</a:ObjectID>
<a:Name>getAllData</a:Name>
<a:Code>getAllData</a:Code>
<a:CreationDate>1787333121</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787333138</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>Override</a:Stereotype>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	this.data.clear();
	try {
		callableSatement = conn.prepareCall(&quot;{ call &quot; + crudOps.get(&quot;retrieve&quot;) + &quot; }&quot;);
		
		resultSet = callableSatement.executeQuery();
		
		while (resultSet.next()) {
			List&lt;Object&gt; row = new Vector&lt;Object&gt;();
			
			for (int i=0; i&lt; columns.size(); i++)
			{
				row.add(resultSet.getObject(columns.get(i).getColumName()));
			}
			
			this.data.add(row);
		}
	} catch (SQLException e) {
		// TODO Auto-generated catch block
		e.printStackTrace();
	}
}
</a:TemplateBody>
