<a:Stereotype>Implement</a:Stereotype>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	for (Subscriber subscriber : subscribers) {
		subscriber.update(this);
	}

}
