<a:Code>editRow</a:Code>
<a:CreationDate>1787328721</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787328761</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>Override</a:Stereotype>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    try {
        callableSatement = conn.prepareCall(&quot;{ call &quot; + crudOps.get(&quot;update&quot;) + &quot; }&quot;);

        // Pretpostavka: prvi parametar je ID, ostalo su podaci za ažuriranje
        callableSatement.setString(1, params.get(&quot;User ID&quot;)); 
        callableSatement.setString(2, params.get(&quot;Username&quot;));
        callableSatement.setString(3, params.get(&quot;Password&quot;));
        callableSatement.setString(4, params.get(&quot;Ime&quot;));
        callableSatement.setString(5, params.get(&quot;Prezime&quot;));
        callableSatement.setString(6, params.get(&quot;Oznaka Role&quot;));

        callableSatement.execute();
    } catch (SQLException e) {
        e.printStackTrace();
        JOptionPane.showMessageDialog(null, &quot;Greška prilikom izmjene korisnika!&quot;, &quot;Greška&quot;, JOptionPane.ERROR_MESSAGE);
    }
}
</a:TemplateBody>
