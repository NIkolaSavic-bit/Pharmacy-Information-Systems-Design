<o:Requirement Id="o29">
<a:ObjectID>0ABAD142-C6CB-49D7-BAD9-2BE1BA6209A1</a:ObjectID>
<a:Requirement.Title>Upravljanje izdatim lijekovima</a:Requirement.Title>
<a:Code>REQ_0011</a:Code>
<a:CreationDate>1779305602</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1779527885</a:ModificationDate>
<a:Modifier>User</a:Modifier>
