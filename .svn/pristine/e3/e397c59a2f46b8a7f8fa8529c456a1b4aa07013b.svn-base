<o:Requirement Id="o24">
<a:ObjectID>2F50FBB1-EC9E-4BC5-AC5B-747B3195AE12</a:ObjectID>
<a:Requirement.Title>Rad sa lijekovima</a:Requirement.Title>
<a:Code>REQ_0008</a:Code>
<a:CreationDate>1779304159</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1779544544</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Testable/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;\red0\green0\blue128;}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\cf1\f0\fs20 Apotekari koji koriste Informacioni sistem Apoteka dozvoljeno je da mogu na jednostavan na\&#39;e8in da upravljaju lijekovima. Zaposleni unose osnovne podatke o lijeku u bazu podataka i imaju mogu\&#39;e6nost brisanje i izmjene unjetog podatka.\cf2\b\f1\fs34\par
}
</a:Description>
<c:Requirements>
<o:Requirement Id="o25">
<a:ObjectID>5698F1CF-ABCF-44B9-8EA9-2389D2F52068</a:ObjectID>
<a:Requirement.Title>Upravljanje prodajom lijekova</a:Requirement.Title>
<a:Code>REQ_0009</a:Code>
<a:CreationDate>1779304608</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1779477084</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Testable/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\fnil\fcharset238 Times New Roman;}{\f1\fnil\fcharset0 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\cf1\f0\fs20 Omogu\&#39;e6ava vo\&#39;f0enje evidencije o prodaji lijekova. Apotekar provjerava stanje lijeka nakon \&#39;e8ega je du\&#39;9ean da izda ra\&#39;e8un kupcu ili drugoj apoteci ukoliko do\&#39;f0e do prodaje lijeka. Nakon prodaje a\&#39;9eurira se stanje skladi\&#39;9ata.\f1\lang1033\par
}
</a:Description>
<c:TraceabilityLinks>
