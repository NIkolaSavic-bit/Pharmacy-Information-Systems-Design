<a:Priority>0</a:Priority>
<a:Status>0</a:Status>
<a:Risk>0</a:Risk>
<a:VerificationMethod/>
<a:Testable/>
<a:Description>{\rtf1\ansi\ansicpg1252\deff0\nouicompat{\fonttbl{\f0\froman\fprq2\fcharset238 Times New Roman CE;}{\f1\fswiss\fcharset238 Arial;}{\f2\fnil\fcharset0 Times New Roman;}{\f3\fnil\fcharset238 Times New Roman;}}
{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\f0\fs20\lang1033 Kupcima je omogu\f1\&#39;e6\f2 eno da kupuju lijekove na osnovu recepta koji im je propisao ljekar. Apotekar provjeravaju da li imaju tra\f3\&#39;9eeni prizvod na stanju, nakon toga unose podatke o pacijentu i imenu ljekara, provjeravaju potpis ljekara koji se nalazi na receptu i pacijentu izadaju tra\&#39;9eeni recept.  \cf1\f2\lang6170\par
}
</a:Description>
<c:TraceabilityLinks>
