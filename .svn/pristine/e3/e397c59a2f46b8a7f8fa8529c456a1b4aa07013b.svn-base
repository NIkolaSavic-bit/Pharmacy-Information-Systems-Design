\pard\cf1\f0\fs20\lang1033 Administrator ima mogu\f1\lang6170\&#39;e6nost kreiranja novog korisnika informacionog sistema Apoteka kao i da mu dodjeli privilegije, brisanje postoje\&#39;e6eg korisnika kao i izmjenu podataka postoje\&#39;e6eg korisnika.\f0\lang1033\par
