{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\widctlpar\ri166\sa94\sl252\slmult1\f0\fs20 Informacioni sistem Apoteka omogu\&#39;e6ava upravniku apoteke da vodi evidenciju o poslovnica koje se nalazae u vlasni\&#39;9atvu privrednog subjekta. Jedna apoteka mo\&#39;9ee da ima vi\&#39;9ae poslovnica\cf1\f1\lang6170\par
}
</a:Description>
<c:Requirements>
<o:Requirement Id="o21">
<a:ObjectID>0705BCBE-6D0D-49CD-B26C-F7AD48488A46</a:ObjectID>
