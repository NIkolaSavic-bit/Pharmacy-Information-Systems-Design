{\colortbl ;\red0\green0\blue0;}
{\*\generator Riched20 10.0.26100}\viewkind4\uc1 
\pard\f0\fs20 Administrator koji je zaposlen u apoteci ima najvise privilegije i nadleznosti u toj apoteci. On upravlja korisnicima informacionog sistema.\cf1\f1\par
}
