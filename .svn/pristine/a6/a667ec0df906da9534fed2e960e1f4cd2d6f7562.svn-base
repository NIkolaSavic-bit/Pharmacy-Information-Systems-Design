<o:Operation Id="o221">
<a:ObjectID>E8A14DFC-EB04-4A9D-A5A9-F420C198C89B</a:ObjectID>
<a:Name>getConnection</a:Name>
<a:Code>getConnection</a:Code>
<a:CreationDate>1787384993</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787385025</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>Override</a:Stereotype>
<a:GlobalObjectID/>
<a:ReturnType>Connection</a:ReturnType>
<a:TemplateBody>{
	this.type = DatabaseType.MySQL;
	this.driver = &quot;com.mysql.jdbc.Driver&quot;;
	this.address = adress.trim();
	this.port = port;
	this.dbName = dbName.trim();

	if (port != null)
	{
		this.fullAddress = this.address + &quot;:&quot; + port.trim();
	}
	else
	{
		this.fullAddress = this.address;
	}

	this.url = &quot;jdbc:mysql://&quot; + this.fullAddress + &quot;/&quot;;

	if (!isConnectionOpen())
	{
		this.user = user.trim();
		this.password = password.trim();
		this.url += this.dbName;
		try
		{
			Class.forName(this.driver);

			Properties properties = new Properties();
			properties.put(&quot;user&quot;, this.user);
			properties.put(&quot;password&quot;, this.password);
			properties.put(&quot;useUnicode&quot;, &quot;true&quot;);
			properties.put(&quot;characterEncoding&quot;, &quot;ISO8859_2&quot;);

			conn = DriverManager.getConnection(this.url, properties);

			return conn;
		}
		catch (ClassNotFoundException e)
		{
			ErrorHandlerMethod(null, e.getMessage());
		}
		catch (SQLException e)
		{
			ErrorHandlerMethod(null, e.getMessage());
		}

		return null;
	}

	return conn;
}
</a:TemplateBody>
