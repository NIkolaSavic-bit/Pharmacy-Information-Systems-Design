<o:Operation Id="o443">
<a:ObjectID>2D76A38B-4B26-463D-B6CE-A01AA48A452B</a:ObjectID>
<a:Name>setData</a:Name>
<a:Code>setData</a:Code>
<a:CreationDate>1787332736</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787332767</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
    this.data = data;
    if (data.isEmpty()) {
        ensureDummyRow();
    }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o444">
<a:ObjectID>B56E9519-07F5-4D06-9B4C-FE7B376EEF8E</a:ObjectID>
<a:Name>data</a:Name>
<a:Code>data</a:Code>
<a:CreationDate>1787332736</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787332767</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:WSDLDataType>List&lt;List&lt;Object&gt;&gt;</a:WSDLDataType>
<a:Parameter.DataType>List&lt;List&lt;Object&gt;&gt;</a:Parameter.DataType>
</o:Parameter>
