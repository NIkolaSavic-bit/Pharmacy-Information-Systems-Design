<o:Operation Id="o203">
<a:ObjectID>E6DEEF3D-3B03-47CC-83A8-38182003B9AA</a:ObjectID>
<a:Name>getConnection</a:Name>
<a:Code>getConnection</a:Code>
<a:CreationDate>1787384804</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787384824</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>Connection</a:ReturnType>
<a:TemplateBody>{
	if(conn != null)
	{
		return conn;
	}
	return null;
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o204">
<a:ObjectID>25442111-10C4-4641-8CAE-97BC0C889B6E</a:ObjectID>
<a:Name>ErrorHandlerMethod</a:Name>
<a:Code>ErrorHandlerMethod</a:Code>
<a:CreationDate>1787384804</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787384824</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>#</a:Operation.Visibility>
<a:TemplateBody>{
	JOptionPane.showMessageDialog(component, errorMsg, &quot;Error&quot;,0);
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o205">
<a:ObjectID>A98E3573-077D-4CA2-BBB8-1A91FA21F52A</a:ObjectID>
<a:Name>component</a:Name>
<a:Code>component</a:Code>
<a:CreationDate>1787384804</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787384824</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:WSDLDataType>Component</a:WSDLDataType>
<a:Parameter.DataType>Component</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o206">
<a:ObjectID>BFC06846-AEB6-4057-A0E1-054000531166</a:ObjectID>
<a:Name>errorMsg</a:Name>
<a:Code>errorMsg</a:Code>
<a:CreationDate>1787384804</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787384824</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:GlobalObjectID/>
<a:WSDLDataType>xsd:string</a:WSDLDataType>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o207">
<a:ObjectID>6D8F3390-AE75-4101-991D-38B3772614AC</a:ObjectID>
<a:Name>closeConnection</a:Name>
<a:Code>closeConnection</a:Code>
<a:CreationDate>1787384804</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787384824</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Comment>Metoda {@link #closeConnection()} sluzi za zatvaranje konekcije. Nakon zatvaranja objekat tipa {@link Connection}
postavlja se na vrijednost &lt;code&gt;null&lt;/code&gt;.
</a:Comment>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	if(conn == null)
		return;
	try
	{
		conn.close();
	}
	catch (Exception e) {
		ErrorHandlerMethod(null, e.getMessage());
	}
	finally {
		conn = null;
	}
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o208">
<a:ObjectID>FBE2F59A-75F4-4541-8436-554A37233184</a:ObjectID>
<a:Name>isConnectionOpen</a:Name>
<a:Code>isConnectionOpen</a:Code>
<a:CreationDate>1787384804</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787384824</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Comment>Metoda {@link #isConnectionOpen()} provjerava da li je konekcija otvorena.
</a:Comment>
<a:GlobalObjectID/>
<a:ReturnType>boolean</a:ReturnType>
<a:TemplateBody>{
	return (conn != null);
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,144={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,85=@return &lt;code&gt;True&lt;/code&gt; ako je konekcija otvorena u suprotnom &lt;code&gt;False&lt;/code&gt;.


</a:ExtendedAttributesText>
