<o:Operation Id="o1105">
<a:ObjectID>D37A9CDC-7FDD-47D0-BD34-E8F9788C2142</a:ObjectID>
<a:Name>ApplicationModel</a:Name>
<a:Code>ApplicationModel</a:Code>
<a:CreationDate>1787327591</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787327736</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:GlobalObjectID/>
<a:TemplateBody>{
	setContext(new ApplicationContext());
	setApplicationState(new IdleState());
	dataModel = context.getTableStack().getLast();
	this.subscribers = new Vector&lt;Subscriber&gt;();
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o1106">
<a:ObjectID>395C78B6-EE42-498C-99E8-CDF17748B826</a:ObjectID>
<a:Name>notifySubscribers</a:Name>
<a:Code>notifySubscribers</a:Code>
<a:CreationDate>1787327591</a:CreationDate>
<a:Creator>User</a:Creator>
<a:ModificationDate>1787327736</a:ModificationDate>
<a:Modifier>User</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:GlobalObjectID/>
<a:ReturnType>void</a:ReturnType>
<a:TemplateBody>{
	for (Subscriber subscriber : subscribers) {
		subscriber.update(this);
	}

}
</a:TemplateBody>
