package state;

import model.ApplicationModel;

/**
 * Predstavlja stanje bez aktivno izabrane tabele.
 */
public class IdleState extends ApplicationState {

    /**
     * Inicijalizuje objekat za rad u aplikaciji.
     *
     * @param applicationModel centralni model aplikacije
     */
    public IdleState(ApplicationModel applicationModel) {
        super(applicationModel);
    }

    /**
     * Vraća naziv stanja namijenjen prikazu u interfejsu.
     *
     * @return naziv trenutnog stanja
     */
    @Override
    public String getDisplayName() {
        return "Neaktivno";
    }
}
